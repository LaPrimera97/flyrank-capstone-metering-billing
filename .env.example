# --- Database ---
# Local Docker Postgres (docker compose up) uses these defaults.
DATABASE_URL=postgresql+psycopg2://billing:billing@localhost:5432/billing

# --- Stripe (TEST MODE ONLY — never put live keys here) ---
# Get these from https://dashboard.stripe.com/test/apikeys (Test mode toggle ON)
STRIPE_SECRET_KEY=sk_test_placeholder
# Get this by running `stripe listen --forward-to localhost:8000/webhooks/stripe`
# The CLI prints a whsec_... value — paste it here.
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# Create these as Products/Prices in the Stripe test dashboard, or via `stripe products create`
STRIPE_PRO_PRICE_ID=price_placeholder

# --- App ---
APP_ENV=development
# Base URL Stripe Checkout redirects back to
APP_BASE_URL=http://localhost:8000
